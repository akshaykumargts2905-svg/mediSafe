DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"
PORT=5000
# Generate a unique random value of at least 32 bytes; never use a default secret.
JWT_SECRET=
JWT_EXPIRES_IN=1d
# Comma-separated existing user IDs allowed to edit the shared catalog.
CATALOG_EDITOR_IDS=
FRONTEND_ORIGINS=http://localhost:3000
# Optional absolute directory for local OCR models; default: backend/.cache/tessdata.
# Run npm run ocr:setup after npm ci.
OCR_DATA_DIR=
# Optional LibreTranslate endpoint for text not already translated in the catalog.
# Seeded clinical explanations and English/Hindi UI do not require this provider.
TRANSLATION_URL=
TRANSLATION_API_KEY=
