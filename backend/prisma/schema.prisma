
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  PATIENT
  DOCTOR
}

enum InteractionSeverity {
  LOW
  MODERATE
  HIGH
  CRITICAL
}

// =========================
// USER
// =========================

model User {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String?
  createdAt DateTime @default(now())
  role      UserRole @default(PATIENT)
  language  String   @default("en")

  prescriptions Prescription[]
  doctors       CareAccess[] @relation("PatientAccess")
  patients      CareAccess[] @relation("DoctorAccess")
}

model CareAccess {
  patientId Int
  doctorId  Int
  createdAt DateTime @default(now())
  patient User @relation("PatientAccess", fields: [patientId], references: [id], onDelete: Cascade)
  doctor User @relation("DoctorAccess", fields: [doctorId], references: [id], onDelete: Cascade)
  @@id([patientId, doctorId])
  @@index([doctorId])
}

// =========================
// PRESCRIPTION
// =========================

model Prescription {
  id        Int      @id @default(autoincrement())
  userId    Int
  fileName  String
  fileUrl   String?
  ocrText   String?
  createdAt DateTime @default(now())

  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  medicines       PrescriptionMedicine[]
  reports         SafetyReport[]
  alerts          Alert[]
  ocrResult       OCRResult?
  recommendations DoctorRecommendation[]
  image           PrescriptionImage?
}

// Kept out of regular prescription responses. Only the authorized image endpoint reads bytes.
model PrescriptionImage {
  prescriptionId Int @id
  bytes          Bytes
  mimeType       String
  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

// =========================
// OCR RESULT
// =========================

model OCRResult {
  id             Int      @id @default(autoincrement())
  prescriptionId Int      @unique
  extractedText  String
  confidence     Float?
  language       String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())
  candidates     Json?
  inputMethod    String @default("MANUAL")
  reviewVersion  Int @default(1)
  confirmedAt    DateTime?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

// =========================
// MEDICINE
// =========================

model Medicine {
  id          Int      @id @default(autoincrement())
  name        String
  genericName String?
  brandName   String?
  rxCui       String?  @unique
  atcCode     String?
  strength    String?
  dosageForm  String?
  aliases     String[] @default([])
  createdAt   DateTime @default(now())

  prescriptions PrescriptionMedicine[]

  interactionsAsA DrugDrugInteraction[] @relation("MedicineA")
  interactionsAsB DrugDrugInteraction[] @relation("MedicineB")

  foodInteractions DrugFoodInteraction[]

  recommendations DoctorRecommendation[]
  alternatives    AlternativeMedicine[] @relation("OriginalMedicine")
  alternativeFor  AlternativeMedicine[] @relation("AlternativeMedicine")
}

model AlternativeMedicine {
  id                    Int @id @default(autoincrement())
  medicineId            Int
  alternativeMedicineId Int
  reason                String
  reasonHi              String?
  sourceUrl             String
  medicine Medicine @relation("OriginalMedicine", fields: [medicineId], references: [id], onDelete: Cascade)
  alternativeMedicine Medicine @relation("AlternativeMedicine", fields: [alternativeMedicineId], references: [id], onDelete: Cascade)
  @@unique([medicineId, alternativeMedicineId])
}

// =========================
// PRESCRIPTION ↔ MEDICINE
// =========================

model PrescriptionMedicine {
  id             Int     @id @default(autoincrement())
  prescriptionId Int
  medicineId     Int
  dosage         String?
  frequency      String?
  duration       String?

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicine Medicine @relation(fields: [medicineId], references: [id])

  @@unique([prescriptionId, medicineId])
}

// =========================
// DRUG ↔ DRUG INTERACTION
// =========================

model DrugDrugInteraction {
  id             Int     @id @default(autoincrement())
  medicineAId    Int
  medicineBId    Int
  severity       InteractionSeverity
  description    String
  recommendation String?
  risk           String?
  descriptionHi  String?
  recommendationHi String?
  riskHi         String?
  sourceUrl      String?

  medicineA Medicine @relation("MedicineA", fields: [medicineAId], references: [id], onDelete: Cascade)

  medicineB Medicine @relation("MedicineB", fields: [medicineBId], references: [id], onDelete: Cascade)

  @@unique([medicineAId, medicineBId])
}

// =========================
// FOOD
// =========================

model Food {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  nameHi    String?
  createdAt DateTime @default(now())

  interactions DrugFoodInteraction[]
}

// =========================
// DRUG ↔ FOOD INTERACTION
// =========================

model DrugFoodInteraction {
  id             Int     @id @default(autoincrement())
  medicineId     Int
  foodId         Int
  severity       InteractionSeverity
  description    String
  recommendation String?
  risk           String?
  descriptionHi  String?
  recommendationHi String?
  riskHi         String?
  sourceUrl      String?

  medicine Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)

  food Food @relation(fields: [foodId], references: [id], onDelete: Cascade)

  @@unique([medicineId, foodId])
}

// =========================
// SAFETY REPORT
// =========================

model SafetyReport {
  id             Int      @id @default(autoincrement())
  prescriptionId Int
  overallStatus  String
  totalMedicines Int      @default(0)
  totalAlerts    Int      @default(0)
  highRiskCount  Int      @default(0)
  summary        String?
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

// =========================
// ALERT
// =========================

model Alert {
  id             Int      @id @default(autoincrement())
  prescriptionId Int
  type           String
  severity       InteractionSeverity
  title          String
  message        String
  messageHi      String?
  risk           String?
  riskHi         String?
  recommendation String?
  recommendationHi String?
  sourceUrl      String?
  language       String   @default("en")
  isRead         Boolean  @default(false)
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
}

// =========================
// DOCTOR RECOMMENDATION
// =========================

model DoctorRecommendation {
  id             Int      @id @default(autoincrement())
  prescriptionId Int
  medicineId     Int
  alternative    String?
  reason         String
  reasonHi       String?
  alternativeHi  String?
  status         String   @default("PENDING")
  createdAt      DateTime @default(now())

  prescription Prescription @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)

  medicine Medicine @relation(fields: [medicineId], references: [id])
}
